{
  "color": {
    "$type": "color",
    "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.4667, 0.4667, 0.4667], "hex": "#777777" } },
    "text": { "$value": "{color.ink}" },
    "background": { "$value": "{color.white}" },
    "overlay": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.5 } },
    "loop-a": { "$value": "{color.loop-b}" },
    "loop-b": { "$value": "{color.loop-a}" },
    "muted": { "$value": "{color.subtle}" },
    "subtle": { "$value": "{color.gone}" }
  }
}
